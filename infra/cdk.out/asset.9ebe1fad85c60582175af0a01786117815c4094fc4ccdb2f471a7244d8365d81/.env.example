# ============================================================================
# EcoBite Backend — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./ecobite.db
# PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ecobite

# ----------------------------------------------------------------------------
# Auth / JWT
# ----------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ----------------------------------------------------------------------------
# AWS Core
# ----------------------------------------------------------------------------
# Retrieve from Secrets Manager after cdk deploy:
#   aws secretsmanager get-secret-value --secret-id EcoBiteServiceUserKey \
#     --query SecretString --output text
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ----------------------------------------------------------------------------
# AWS S3 — profile photo storage
# ----------------------------------------------------------------------------
S3_BUCKET_NAME=ecobite-uploads
# Set from CloudFrontDomain output of cdk deploy:
CLOUDFRONT_DOMAIN=

# ----------------------------------------------------------------------------
# AWS Rekognition — food image detection
# ----------------------------------------------------------------------------
REKOGNITION_MIN_CONFIDENCE=70.0

# ----------------------------------------------------------------------------
# AWS Transcribe — voice ingredient detection
# ----------------------------------------------------------------------------
TRANSCRIBE_LANGUAGE_CODE=en-US
TRANSCRIBE_VOCABULARY_FILTER=

# ----------------------------------------------------------------------------
# AWS Bedrock — AI recipe generation (Claude)
# ----------------------------------------------------------------------------
# Claude model ID. Options (cheapest → best quality):
#   anthropic.claude-3-5-haiku-20241022-v1:0    ~$0.003/recipe  ← recommended
#   anthropic.claude-3-5-sonnet-20241022-v2:0   ~$0.015/recipe
#   anthropic.claude-3-opus-20240229-v1:0        ~$0.075/recipe
# Leave empty to disable Bedrock and use the built-in recipe catalogue instead.
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Bedrock region — Claude is available in us-east-1 and us-west-2.
# Leave empty to use the same region as AWS_REGION.
BEDROCK_REGION=us-east-1
