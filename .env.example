# EcoBite Frontend — Environment Variables
# Copy this to .env.local and fill in your values.
#
# ─── Production (ECS Fargate) ───────────────────────────────────────────────
# After running `cdk deploy`, copy the "BackendApiUrl" CDK output here.
# It will look like:
#   http://<stack>-EcoBite-<id>.<region>.elb.amazonaws.com/api/v1
#
VITE_API_URL=

# ─── Local Development ───────────────────────────────────────────────────────
# Uncomment to point at a local backend (default when VITE_API_URL is empty):
# VITE_API_URL=http://localhost:8000/api/v1
