# PyTorch recipe model server (model/serve.py)
# Start with: cd model && uvicorn serve:app --port 8001
# Ingest the Kaggle dataset: python model/scripts/ingest_kaggle.py --csv /path/to/recipes.csv
# Build index:               cd model && python build_index.py
MODEL_SERVER_URL=http://localhost:8001

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
